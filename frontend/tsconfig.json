{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", ".next/types/app/dashboard/Report/page.tsx", ".next/types/app/dashboard/OBDData/page.tsx", ".next/types/app/dashboard/MaintenanceRecord/page.tsx", ".next/types/app/dashboard/InventoryItem/page.tsx", ".next/types/app/dashboard/GpsData/page.tsx", ".next/types/app/dashboard/FuelData/page.tsx", ".next/types/app/dashboard/EmissionData/page.tsx", ".next/types/app/dashboard/DeviceHeartbeat/page.tsx", ".next/types/app/dashboard/ConnectionState/page.tsx", ".next/types/app/dashboard/Alert/page.tsx", ".next/types/app/dashboard/ActivityLog/page.tsx"],
  "exclude": ["node_modules"]
}
